{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quay-term",
  "version": "0.0.0",
  "identifier": "io.github.bhali16.quayterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "title": "quay-term", "label": "main", "width": 1100, "height": 720, "minWidth": 600, "minHeight": 400 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
