{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-start-dragging", "core:window:allow-toggle-maximize", "dialog:allow-open", "dialog:allow-save", "updater:default", "process:allow-restart", "opener:allow-open-url", "opener:allow-reveal-item-in-dir", "notification:default", "core:window:allow-show", "core:window:allow-unminimize", "core:window:allow-set-focus"]
}
