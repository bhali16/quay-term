{
  "name": "quay-term-ui",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config app/ui/vite.config.ts app/ui",
    "build": "vite build --config app/ui/vite.config.ts app/ui",
    "check": "svelte-check --workspace app/ui --tsconfig ./tsconfig.json",
    "tauri": "cd app/src-tauri && tauri",
    "tauri:setup": "cd app/setup && tauri",
    "setup:dev": "vite --config app/setup/ui/vite.config.ts app/setup/ui",
    "setup:build": "vite build --config app/setup/ui/vite.config.ts app/setup/ui",
    "setup:check": "svelte-check --workspace app/setup/ui --tsconfig ./tsconfig.json",
    "test": "vitest run --root app/ui"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
